FROM node:22-bookworm-slim AS build
WORKDIR /app

ARG NEXT_PUBLIC_KEYCLOAK_URL
ARG NEXT_PUBLIC_KEYCLOAK_REALM=nexus
ARG NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nexus-web
ARG NEXT_PUBLIC_GUEST_CART_ENABLED=false
ARG NEXT_PUBLIC_ACCOUNT_EXTENSIONS_ENABLED=false
ARG NEXT_PUBLIC_SELLER_APPLICATION_ENABLED=false
ENV NEXT_PUBLIC_API_URL="" \
    NEXT_PUBLIC_API_BASE_URL="" \
    API_PROXY_TARGET="" \
    NEXT_PUBLIC_KEYCLOAK_URL=$NEXT_PUBLIC_KEYCLOAK_URL \
    NEXT_PUBLIC_KEYCLOAK_REALM=$NEXT_PUBLIC_KEYCLOAK_REALM \
    NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=$NEXT_PUBLIC_KEYCLOAK_CLIENT_ID \
    NEXT_PUBLIC_GUEST_CART_ENABLED=$NEXT_PUBLIC_GUEST_CART_ENABLED \
    NEXT_PUBLIC_ACCOUNT_EXTENSIONS_ENABLED=$NEXT_PUBLIC_ACCOUNT_EXTENSIONS_ENABLED \
    NEXT_PUBLIC_SELLER_APPLICATION_ENABLED=$NEXT_PUBLIC_SELLER_APPLICATION_ENABLED \
    NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
