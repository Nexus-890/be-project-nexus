# Copy to infra/staging/.env on the STAGING host only and fill every <change-me>.
# Never commit .env. Generate secrets with: openssl rand -base64 36
TZ=Asia/Ho_Chi_Minh

# Public DNS name of the VM; nginx, Keycloak and the web build use it.
STAGING_HOST=<staging.example.org>
LETSENCRYPT_EMAIL=<ops-mailbox@example.org>
# Image tag for every application image; use the short commit SHA you deploy.
NEXUS_TAG=<git-short-sha>

DB_USERNAME=nexus
DB_PASSWORD=<change-me>
REDIS_PASSWORD=<change-me>

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<change-me>
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=<change-me>
KEYCLOAK_NOTIFICATION_SERVICE_CLIENT_SECRET=<change-me>
KEYCLOAK_CONFIG_SERVICE_CLIENT_SECRET=<change-me>
AUCTION_RATING_CLIENT_SECRET=<change-me>

# Demo accounts imported with the realm: admin@nexus.local, seller@nexus.local, buyer@nexus.local
DEMO_ADMIN_PASSWORD=<change-me>
DEMO_SELLER_PASSWORD=<change-me>
DEMO_BUYER_PASSWORD=<change-me>

# Same value in config-service and notification-service, at least 32 characters.
CONFIG_AUDIT_SHARED_SECRET=<change-me>

MAIL_FROM=no-reply@nexus.local
EMAIL_NOTIFICATION_ENABLED=false

ALLOW_GUEST_CART=false
CART_GUEST_TOKEN_SECRET=<change-me>
FEATURE_REPUTATION_ENFORCEMENT=false

PAYMENT_PROVIDER=SEPAY
SEPAY_BANK_ID=970415
SEPAY_BANK_ACCOUNT=<bank-account-number>
SEPAY_ACCOUNT_NAME=<account-holder-name>
SEPAY_TRANSFER_CONTENT_PREFIX=SEVQR
SEPAY_WEBHOOK_SECRET=<change-me>
PAYOUT_PROVIDER=sandbox
PAYOUT_ACCOUNT_ENCRYPTION_KEY=<change-me>

SHIPPING_CARRIER=NONE
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_SHOP_ID=0
GHN_TOKEN=<change-me>
GHN_WEBHOOK_SECRET=<change-me>

SUPABASE_URL=<https://project-ref.supabase.co>
SUPABASE_SERVICE_KEY=<change-me>
SUPABASE_BUCKET=product-images

# Loopback-only ports for an SSH tunnel; nothing else is published except 80 and 443.
ZIPKIN_LOCAL_PORT=9411
MAILPIT_LOCAL_PORT=8025
