# Copy to .env ON THE VM, chmod 600. Fill every blank required value there.
# This file contains placeholders only. Never commit the host's .env.
DOMAIN=
ACME_EMAIL=
IMAGE_PREFIX=nexus-staging
# Managed by scripts/staging.sh; use the full Git commit SHA for manual commands.
RELEASE_TAG=

DB_USERNAME=nexus
DB_PASSWORD=
REDIS_PASSWORD=
KEYCLOAK_ADMIN=nexus-operator
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=
KEYCLOAK_NOTIFICATION_SERVICE_CLIENT_SECRET=
DEMO_ADMIN_PASSWORD=
DEMO_SELLER_PASSWORD=
DEMO_BUYER_PASSWORD=
CART_GUEST_TOKEN_SECRET=

# SMTP for Keycloak verification/reset mail and Notification (no public Mailpit).
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true

# Required for verifying webhook authentication; use the provider's host value.
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_ID=970415
SEPAY_VIETQR_TEMPLATE=compact
SEPAY_TRANSFER_CONTENT_PREFIX=SEVQR
# 32 random bytes encoded as base64; keep this stable across image rollbacks.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
PAYOUT_CALLBACK_SECRET=
PAYOUT_PROVIDER=sandbox
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_TOKEN=

# Optional external integrations. Blank storage means image uploads are unavailable.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images
SHIPPING_CARRIER=NONE
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=0
GHN_WEBHOOK_SECRET=
SHIPPING_DEFAULT_WAREHOUSE_ID=
SHIPPING_PICKUP_PROVINCE_CODE=
SHIPPING_PICKUP_WARD_CODE=
SHIPPING_PICKUP_ADDRESS_LINE=
