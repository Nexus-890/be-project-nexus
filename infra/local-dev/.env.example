TZ=Asia/Ho_Chi_Minh

DB_HOST=localhost
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

ALLOW_GUEST_CART=false
CART_MERGE_ON_LOGIN=true
CART_GUEST_TOKEN_SECRET=

# Optional host port for the Compose rating profile.
RATING_PORT=8089

KAFKA_PORT=
KAFKA_UI_PORT=

KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Set local demo passwords before running: .\keycloak\seed-users.ps1 (PowerShell)
# Demo emails and UUIDs are fixed in keycloak/realm-nexus.json.
DEMO_ADMIN_PASSWORD=
DEMO_SELLER_PASSWORD=
DEMO_BUYER_PASSWORD=
KEYCLOAK_USER_SERVICE_CLIENT_SECRET=
# Optional: only needed when EMAIL_NOTIFICATION_ENABLED=true (#191)
KEYCLOAK_NOTIFICATION_SERVICE_CLIENT_SECRET=
# Dedicated read-only realm client for GET /api/v1/system/configs (#217).
KEYCLOAK_CONFIG_SERVICE_CLIENT_SECRET=
AUCTION_RATING_CLIENT_SECRET=
RATING_ELIGIBILITY_ALLOWED_CLIENTS=nexus-auction-service
FEATURE_REPUTATION_ENFORCEMENT=false
AUCTION_RATING_BASE_URL=
AUCTION_RATING_CLIENT_ID=nexus-auction-service
AUCTION_RATING_TOKEN_URI=http://localhost:18080/realms/nexus/protocol/openid-connect/token
AUCTION_RATING_TOKEN_TIMEOUT_MS=1500

REDIS_PORT=
REDIS_PASSWORD=

MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=
# Keycloak mail for password reset and email verification (#210, #262). It runs inside
# the Compose network, so it reaches Mailpit by service name and its container port.
# No SMTP password: Mailpit accepts any login locally.
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@nexus.local
EMAIL_NOTIFICATION_ENABLED=false
NOTIFICATION_RETRY_LIMIT=3

ZIPKIN_PORT=9411

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

SHIPPING_CARRIER=NONE
SHIPPING_QUOTE_CARRIER=
SHIPPING_BOOKING_CARRIER=
SHIPPING_CHECKOUT_CARRIERS=
SHIPPING_CARRIER_STRATEGY=CHEAPEST
ORDER_AUTO_COMPLETE_DAYS=3
ORDER_AUTO_COMPLETE_INTERVAL=10m
ORDER_AUTO_COMPLETE_BATCH_SIZE=100
SHIPPING_API_TIMEOUT_MS=3000
SHIPPING_RETRY_LIMIT=3
SHIPPING_RETRY_BACKOFF_MS=100
SHIPPING_BREAKER_FAILURE_THRESHOLD=5
SHIPPING_BREAKER_OPEN_MS=30000
FREE_SHIPPING_THRESHOLD=1000000
SHIPPING_DEFAULT_WAREHOUSE_ID=
SHIPPING_PICKUP_PROVINCE_CODE=
SHIPPING_PICKUP_WARD_CODE=
SHIPPING_PICKUP_ADDRESS_LINE=
SHIPPING_CATALOG_BASE_URL=
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_SHOP_ID=
GHN_PAYMENT_TYPE_ID=1
GHN_REQUIRED_NOTE=KHONGCHOXEMHANG
GHN_HTTP_TIMEOUT_MS=1500
GHN_MASTER_DATA_CACHE_TTL_MS=300000
GHN_TOKEN=

PAYMENT_PROVIDER=SEPAY
PAYMENT_RETRY_LIMIT=3
SEPAY_BANK_ID=970415
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_VIETQR_TEMPLATE=compact
SEPAY_TRANSFER_CONTENT_PREFIX=SEVQR
SEPAY_WEBHOOK_SECRET=

# Seller payouts (#272): the local essentials. Durations/retries/storage limits have central defaults.
# For MANUAL use MANUAL / false / true; both execution switches default off.
PAYOUT_EXECUTION_MODE=AUTO
PAYOUT_JOBS_ENABLED=false
PAYOUT_MANUAL_ENABLED=false
# Base64-encoded AES-256 key supplied through the backend secret mechanism.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
# Source aliases work in Java/IDE and Compose; no bank credentials.
# Example: [{"id":"platform-main","alias":"Platform payout account"}]
PAYOUT_MANUAL_SOURCE_ACCOUNTS_JSON=[]
# Separate PRIVATE bucket; reuses SUPABASE_URL/SUPABASE_SERVICE_KEY configured below.
PAYOUT_EVIDENCE_BUCKET=payout-evidence
# Optional AUTO/provider overrides and tuning: docs/payment-manual-payouts.md.

# Catalog image upload: use the existing PUBLIC product-images bucket.
# Keep the service-role key on the backend host only; never use a NEXT_PUBLIC_ variable.
# Project root URL: https://<project-ref>.supabase.co (without /rest/v1).
SUPABASE_URL=
# Optional public client key. This does NOT replace SUPABASE_SERVICE_KEY for BE writes.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images
MAX_PRODUCT_IMAGES=5
MAX_IMAGE_FILE_SIZE=5MB

# #211: dùng cùng một secret tối thiểu 32 ký tự tại config-service và notification-service.
# Tạo secret trên deployment; không commit giá trị thật. Audit chưa gửi được sẽ nằm trong hàng đợi.
CONFIG_AUDIT_SHARED_SECRET=
# Đường dẫn persistent disk của một Config Server (không dùng chung file giữa các instance).
SYSTEM_CONFIG_STATE_FILE=./data/system-configs.json
