TZ=Asia/Ho_Chi_Minh

DB_HOST=localhost
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

# Optional host port for the Compose rating profile.
RATING_PORT=8089

KAFKA_PORT=
KAFKA_UI_PORT=

KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

REDIS_PORT=
REDIS_PASSWORD=

MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=

ZIPKIN_PORT=9411

PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

JWT_KEY_ID=nexus-rs256-local-01
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Catalog image upload: use the existing PUBLIC product-images bucket.
# Keep the service-role key on the backend host only; never use a NEXT_PUBLIC_ variable.
# Project root URL: https://<project-ref>.supabase.co (without /rest/v1).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images
MAX_PRODUCT_IMAGES=5
MAX_IMAGE_FILE_SIZE=5MB
